# Catch Everything - runtime settings / 런타임 설정
#
# Install copies this file to ~/Library/Application Support/MeetingCapture/config.env (an existing file is never overwritten).
# 설치 스크립트가 위 위치로 복사합니다. 이미 있는 config.env는 덮어쓰지 않습니다.
# Edit that copy, then restart the app (Quit and reopen) / 수정 후 앱을 다시 시작하세요. The Python pipeline reads it on every run.
#
# Format: KEY=VALUE, one per line. '#' starts a comment at the line start or after a space. No quotes needed (a value may
# contain spaces, e.g. "My Drive"). '~' is expanded. Both the Swift app and the Python pipeline read this file; keys that
# one side does not use are ignored by it. Put comments on their own line above a path value.
# 형식: KEY=VALUE. 따옴표 불필요(경로에 공백 가능). '~'는 홈 디렉터리로 확장. 앱(Swift)과 파이프라인(Python)이 같은 파일을 읽습니다.
#
# Check the result with:  make doctor   (or, from the pipeline folder of your clone:  cd pipeline && <PYTHON_BIN> -m mcap doctor)
#
# Twenty of these keys can also be changed in the app: menu-bar icon > Settings... (docs/SETTINGS.md). The window changes only the lines you touch (comments,
# blank lines and unknown keys stay, a backup config.env.bak-settings-* is written first) and never puts an API key here: keys live in the macOS Keychain.
# 이 중 20개 키는 앱의 메뉴 막대 아이콘 > Settings...(설정)에서도 바꿀 수 있어요(docs/SETTINGS.md). 창은 건드린 줄만 바꾸고(주석, 빈 줄, 모르는 키는 그대로,
# 먼저 config.env.bak-settings-* 백업을 만들어요) API 키는 여기에 쓰지 않아요: 키는 macOS 키체인에만 저장돼요.

# ============================== Paths / 경로 ==============================

# Where finished meetings are stored: ARCHIVE_DIR/YYYY-MM/YYYY-MM-DD_HHMM_<title>/ (transcript.md, meeting-note.md, audio ...).
# Default: ~/Meetings, a plain local folder. To archive into Google Drive for Desktop (or any other synced folder) point this at it, for example
#   ARCHIVE_DIR=~/Library/CloudStorage/GoogleDrive-<your-account>/My Drive/Meetings
# (scripts/install.sh writes that line itself when exactly one Google Drive account is mounted). If this folder's parent does not exist (a
# synced folder whose app is not running) the meeting stays in staging (~/Library/Application Support/MeetingCapture/sessions) and
# 'mcap reprocess --last' publishes it later.
# 회의록 보관 위치. 기본은 로컬 폴더 ~/Meetings. Google Drive 같은 동기화 폴더에 보관하려면 위 예시처럼 경로를 지정하세요(Drive 계정이 정확히 하나면 install.sh가 채웁니다).
# 부모 폴더가 없으면(동기화 앱이 꺼져 있으면) staging에 남고 나중에 'mcap reprocess --last'로 이동합니다.
ARCHIVE_DIR=~/Meetings

# This repository (the app starts the pipeline from PROJECT_DIR/pipeline). install.sh sets this to the checkout it runs from.
# 이 저장소 위치. install.sh가 현재 체크아웃 경로로 채웁니다.
PROJECT_DIR=~/Developer/meeting-capture

# Python of the pipeline venv (mlx-whisper etc.; created by scripts/setup_python.sh) / 파이프라인용 venv의 python
PYTHON_BIN=~/Library/Application Support/MeetingCapture/venv/bin/python

# Claude Code CLI used for the transcript cleanup / meeting note / verification (billing: see CLAUDE_AUTH below).
# Keep auto-update off so the flags stay stable. / 전사 교정, 회의록, 검증에 쓰는 Claude Code CLI (과금 방식은 아래 CLAUDE_AUTH 참고)
CLAUDE_BIN=~/.local/bin/claude

# ============================== Me / 나 ==============================

# Label of your own microphone track in transcripts and notes (set it to your name); the other track is always "Remote".
# transcript에서 내 마이크 트랙의 이름 (본인 이름으로 바꾸세요. 상대방 트랙은 항상 "Remote")
SELF_NAME=Me

# Language of the app's own texts (notifications, menu hints, dialogs): en | ko. (The language of the note is NOTE_LANGUAGE, below.)
# 앱의 알림, 메뉴 설명, 대화상자 언어: en | ko (노트 언어는 아래 NOTE_LANGUAGE)
UI_LANGUAGE=en

# ============================== Detection / 감지 (Swift app) ==============================

# Platforms to detect automatically: meet, zoom, teams (comma separated). Empty = manual recording only. This list does NOT limit the calls of other apps
# (Slack huddle, FaceTime ...): CALL_DETECT below does.
# 자동 감지할 플랫폼. 비우면 수동 녹음만 가능. 다른 앱의 통화(Slack 허들, FaceTime ...)는 이 목록이 아니라 아래 CALL_DETECT로 정합니다.
ENABLED_PLATFORMS=zoom,teams            # meet is OFF by default (it needs the Chrome automation permission); add meet to enable

# Browser bundle ids that can host Google Meet (comma separated) / Meet를 여는 브라우저 bundle id
BROWSER_BUNDLE_IDS=com.google.Chrome

# How often the audio/process signals are polled (seconds) / 신호 폴링 주기(초)
POLL_INTERVAL_SECONDS=2

# A meeting must look active this long before recording starts (seconds) / 녹음 시작 전 연속 감지 시간(초)
START_DEBOUNCE_SECONDS=4

# Keep recording this long after the meeting signals disappear (seconds); Zoom/Teams and the calls of other apps use at least 30 s.
# 회의 종료 신호 후 녹음을 유지하는 유예 시간(초). Zoom/Teams는 최소 30초.
GRACE_SECONDS=20

# Zoom evidence tiers (the lines below are commented out: these are the built-in defaults; remove the '#' to change one, then restart the app).
# A signed-in, idle Zoom opens a few UDP sockets (4) for a few seconds about every 2 minutes, with no audio at all. That "flicker" must not
# look like a meeting. STRONG evidence = Zoom's main process has at least ZOOM_STRONG_SOCKETS UDP sockets, OR Zoom is using the microphone,
# OR Zoom is playing audio with 3+ sockets: it records after START_DEBOUNCE_SECONDS as always. WEAK evidence (1 to ZOOM_STRONG_SOCKETS-1
# sockets, no audio) only counts as a meeting after it has lasted ZOOM_WEAK_DEBOUNCE_SECONDS, so an unusual real call with few sockets and no
# microphone is still recorded, but only from about 17 s in (the first seconds are lost). 0 = no extra wait (the old behaviour; the flicker
# can then start false recordings). Teams is not affected. `probe` shows the current tier and both values. See docs/DETECTION.md section 3.
# Zoom 근거 등급: 유휴 상태의 Zoom이 약 2분마다 몇 초간 UDP 소켓 4개를 열었다 닫습니다(오디오 없음). 이것을 회의로 오인하지 않도록 합니다.
# 강한 근거(소켓 ZOOM_STRONG_SOCKETS개 이상, 또는 Zoom이 마이크 사용 중, 또는 소리 재생 + 소켓 3개 이상)는 기존대로 START_DEBOUNCE_SECONDS 뒤에 녹음하고,
# 약한 근거(소켓 몇 개뿐, 오디오 없음)는 ZOOM_WEAK_DEBOUNCE_SECONDS(초) 동안 이어져야 회의로 봅니다(0 = 추가 대기 없음). Teams에는 적용되지 않습니다.
# ZOOM_STRONG_SOCKETS=6
# ZOOM_WEAK_DEBOUNCE_SECONDS=15

# Calls of other apps (Slack huddle, Webex, Discord, FaceTime, KakaoTalk, WhatsApp ...): known | generic | off.
#   known   = a built-in table of call apps plus EXTRA_MEETING_APPS, no guessing (the default; this includes the personal messengers of the table: the Menu > Call Apps
#             submenu switches one app off, also before its first call). ENABLED_PLATFORMS does not limit these calls, this key does.
#   generic = known + a GUESS: ANY other GUI app (not a browser, player, recorder, dictation tool, Apple app ...) that holds the microphone and plays sound for
#             CALL_GENERIC_SECONDS is recorded and a notification names it ("<App> looks like a call: recording started. Not a call? Menu > Never record <App>";
#             your choice is kept in call-apps.json). Opt in only if you accept that a game or an audio tool may be recorded.
#   off     = none of this (Zoom, Teams, Meet and manual recording are not affected).
# Only Zoom has been verified in real calls; everything else is implemented from public signals and unit-tested with fakes. Google Meet stays off (ENABLED_PLATFORMS).
# 다른 앱의 통화(Slack 허들, Webex, Discord, FaceTime, 카카오톡, WhatsApp ...): known | generic | off.
#   known = 내장 앱 목록 + EXTRA_MEETING_APPS, 추측 없음(기본값. 목록에는 개인 메신저도 있으며 메뉴 > Call Apps에서 앱별로 끌 수 있습니다). ENABLED_PLATFORMS는 이 통화를 제한하지 않고 이 키가 합니다.
#   generic = known + 추측: 그 밖의 모든 GUI 앱(브라우저, 플레이어, 녹화/받아쓰기 도구, Apple 앱 제외)이 마이크를 쓰면서 CALL_GENERIC_SECONDS 동안 소리도 내면 녹음하고
#   앱 이름이 든 알림을 보냅니다(메뉴 > Never record). 게임이나 오디오 도구가 녹음될 수 있음을 감수할 때만 켜세요. off = 끔(Zoom, Teams, Meet, 수동 녹음은 영향 없음). 실제 통화로 검증된 것은 Zoom뿐입니다.
CALL_DETECT=known
# CALL_GENERIC_SECONDS=45
# Bundle ids of more call apps, comma separated, each `id` or `id=Name`: apps the table does not know (find the id: mdls -name kMDItemCFBundleIdentifier /Applications/App.app).
# 표에 없는 앱의 번들 ID (쉼표로 구분, `id` 또는 `id=이름`)
# EXTRA_MEETING_APPS=
# Also read the address of Chrome tabs for meeting pages of Whereby, Jitsi, Webex web, Teams web and the Zoom web client (needs the Chrome Automation permission like Meet; off = never asked).
# Chrome 탭 주소로 Whereby, Jitsi, Webex 웹, Teams 웹, Zoom 웹 클라이언트 회의 페이지도 감지 (Meet처럼 Chrome 자동화 권한이 필요하므로 기본 꺼짐)
# CALL_BROWSER_URLS=off

# Recordings shorter than this are treated as blips (seconds) / 이보다 짧은 녹음은 오탐으로 간주(초)
MIN_RECORDING_SECONDS=30

# Safety stop for a single recording (hours, max 12) / 한 번의 녹음 최대 길이(시간)
MAX_RECORDING_HOURS=6

# Stop recording when free disk space drops below this (GB) / 디스크 여유가 이 값 미만이면 녹음 중지(GB)
MIN_FREE_DISK_GB=5

# Stop an AUTOMATIC recording when both tracks have been silent for this long (minutes, 0 = off). The recording is kept and
# processed normally (a no-speech session is discarded by the pipeline). / 자동 녹음에서 두 트랙이 이 시간(분) 동안 무음이면 정상 종료(0 = 끔)
NO_SPEECH_STOP_MINUTES=15

# 1 = post a macOS notification when a recording starts and when it ends (title '녹음 시작 · Zoom' / '녹음 종료 · 전사 시작'); the menu-bar icon can be
# hidden by the notch or a menu-bar manager, then this is the only sign that the meeting was noticed. 0 = off. Warnings and results (remote audio
# silent, recording could not start, processing failed, note ready) are always sent. Takes effect after an app restart.
# 1 = 녹음이 시작/종료될 때 macOS 알림. 메뉴바 아이콘이 노치 등에 가려져도 이 알림으로 확인합니다. 0 = 끔 (경고와 결과 알림은 항상 보냄).
NOTIFY_RECORDING=1

# ============================== Audio / 오디오 (Swift app) ==============================

# System audio capture: global = everything the Mac plays (except this app), app = only the meeting app's processes.
# 상대방 음성 캡처 방식: global(시스템 전체) | app(회의 앱만)
SYSTEM_AUDIO_MODE=global

# ============================== ASR / 전사 (Python) ==============================

# Local Whisper model (Hugging Face repo id or a local directory). Full large-v3 for accuracy; changing it is a one-line edit.
# 로컬 Whisper 모델 (HF repo id 또는 로컬 디렉터리). 정확도 우선 large-v3 fp16.
ASR_MODEL=mlx-community/whisper-large-v3-mlx

# Transcription language: auto = per-region Korean/English detection (code-switching), ko, or en.
# 전사 언어: auto(구간별 ko/en 감지, 한영 혼용) | ko | en
ASR_LANGUAGE=auto

# Languages the ASR may use (comma separated). The per-region language ID chooses among them and the foreign-script filter keeps their
# scripts: add ja for Japanese meetings, otherwise kana / kanji lines are dropped as noise. / 전사에 쓸 수 있는 언어 집합(일본어 회의면 ja 추가)
ASR_LANGUAGES=ko,en

# Voice activity detection: auto = Silero if its model is installed, else energy VAD | silero | energy
# 발화 구간 검출: auto(Silero가 있으면 사용, 없으면 energy) | silero | energy
ASR_VAD=auto

# Transcription strategy (local Whisper only; an external engine always runs single). Any other value reads as single.
# dual   = (default) every chunk is decoded TWICE with the same local model, once with the vocabulary prompt and once without, and the two
#          answers are merged by fixed rules (no model, nothing sent anywhere): the plain decode restores short utterances such as "네" and
#          wins where the prompt bent a figure, the prompted decode keeps your own terms. About 1.5 to 1.8 times the transcription time;
#          with an empty vocabulary.txt there is no prompt and each chunk is decoded once. docs/CONFIGURATION.md.
# single = one decode per chunk with your vocabulary as the prompt (what every version before dual did): the faster choice.
# 전사 전략(로컬 Whisper 전용, 외부 엔진은 항상 single). 알 수 없는 값은 single.
# dual(기본) = 같은 로컬 모델로 청크마다 2회(프롬프트 있음 / 없음) 디코딩한 뒤 고정 규칙으로 병합(모델 없음, 외부 전송 없음): 프롬프트가 숫자를 왜곡한 곳은
#        프롬프트 없는 결과가, 용어는 프롬프트 있는 결과가 이긴다. 짧은 발화("네")도 되살린다. 전사 시간이 약 1.5~1.8배(vocabulary가 비어 있으면 프롬프트가 없어 1회만 디코딩).
# single = 청크당 1회 디코딩(vocabulary 프롬프트 포함, dual 이전 버전과 동일): 더 빠르다.
ASR_STRATEGY=dual

# Offline echo cancellation of YOUR microphone track against the system-audio (Remote) track. With the MacBook speakers (or a room
# microphone) the other side's voice leaks into the mic track; this removes it before the transcription, never your own speech.
# auto = apply only when the two tracks show speaker leakage (headphones / a hardware-AEC conference mic are left alone), 1 = always, 0 = never.
# 내 마이크 트랙에 섞인 상대방 음성(스피커 에코)을 전사 전에 오프라인으로 제거. auto = 에코가 감지될 때만 적용(헤드폰/하드웨어 AEC 마이크는 건너뜀) | 1 = 항상 | 0 = 끔
MIC_AEC=auto

# ============================== Claude billing / Claude 과금 (Python) ==============================

# WHO PAYS for the Claude calls of the pipeline (transcript cleanup, note, verification). SPEC 17.
#   api          = an Anthropic Console API key kept in the macOS Keychain: billed PER TOKEN to your Console account. This is the default and
#                  the supported path. Store the key ONCE in Terminal with:   make set-api-key
#                  The macOS security tool asks for it and nothing else sees it: it is never written to this file, a log, state.json, usage.jsonl,
#                  the command line or the session folder. Validate it with:   mcap api-key check   (one tiny call, about a tenth of a cent)
#                  Check what it costs with:   mcap usage   (cost of the last 7 and 30 days by billing path and stage)  and   mcap doctor
#   subscription = your own Claude login (claude.ai plan; run `claude auth login` once). Opt-in. No key is passed, even when the Keychain has one.
#                  WARNING: this tool runs `claude -p` in the background, without you at the keyboard. Anthropic's terms for your plan apply and
#                  limit a consumer login to ordinary individual use. Check them for unattended `claude -p` before you choose this mode.
# WHAT IS BILLED WHERE in api mode: cleanup, note and verification calls = the API key. The ONE exception is the Google Calendar lookup
# (CALENDAR_LOOKUP): the calendar connector belongs to the claude.ai login, an API key cannot use it, so that single call always runs on the
# subscription login (and is skipped quietly when there is no login). It is logged with auth=subscription.
# WARNING: in api mode every call costs real money. A bug, a retry loop or a false-positive recording (a meeting that was not one) costs money
# until a budget below stops it. In the Console create a key just for this project and set a MONTHLY SPEND LIMIT for it (the hard backstop).
# Check the data-handling / retention terms of your plan (API vs claude.ai) before you send meeting text to it.
# 누가 비용을 내는가 (전사 교정, 회의록, 검증 호출). api = Console API 키(macOS Keychain, 토큰당 과금): 기본값이자 지원되는 방식입니다.
# 키는 터미널에서 한 번만 `make set-api-key`로 저장합니다(macOS security 도구가 직접 묻고, 이 파일/로그/state.json/usage.jsonl/명령행/세션 폴더에는 남지 않음).
# `mcap api-key check`로 유효성 확인(아주 작은 호출 1회, 약 0.1센트), `mcap usage`/`mcap doctor`로 비용 확인.
# subscription = 본인의 Claude 로그인(`claude auth login` 1회). 선택 사항이며 키는 Keychain에 있어도 전달하지 않습니다. 경고: 이 도구는 사람이 없는 동안에도
# 백그라운드에서 `claude -p`를 실행합니다. 소비자용 로그인은 약관상 일반적인 개인 사용으로 제한되므로, 무인 `claude -p`가 허용되는지 계정 약관을 먼저 확인하세요.
# api 모드에서 과금처: 정리/노트/검증 = API 키. 단 하나의 예외는 캘린더 조회(커넥터가 claude.ai 로그인에 묶여 있음): 이 호출만 구독 로그인으로 실행되고
# 로그인이 없으면 조용히 건너뜁니다(usage.jsonl에 auth=subscription). 주의: api 모드에서는 버그, 재시도 루프, 오탐 녹음이 곧 돈입니다. Console에서 이 프로젝트
# 전용 키를 만들고 월 지출 한도(spend limit)를 꼭 거세요. 데이터 처리/보관 정책은 플랜(claude.ai vs API)마다 다를 수 있으니 약관을 확인하세요.
CLAUDE_AUTH=api

# Keychain generic-password service name of the key (account = your login name). Change it only if you stored the key under another name.
# Keychain에 저장한 키의 서비스 이름(account = 로그인 사용자 이름). 다른 이름으로 저장했을 때만 바꾸세요.
CLAUDE_KEY_SERVICE=MeetingCapture Anthropic API key

# Budgets in US dollars, api mode only (0 = off; they never apply to the subscription). The defaults are small on purpose (5 a day, 2 per meeting):
# raise them when a long meeting needs more. Counted from the cost the CLI reports for every call
# (usage.jsonl). DAILY: when today's (local date) cost reaches it, every later Claude stage of the day is skipped: cleanup / verification
# are skipped with a warning, the note fails with error_kind budget_daily, the transcript is still published and the session waits for
# midnight (it is NOT counted as a failed attempt; `mcap reprocess --pending` finishes it the next day). PER MEETING: one pipeline run
# stops cleanup / verification / calendar when its own cost reaches it; the note call is always reserved and never skipped by this one.
# The check happens before each call starts: calls that were already running (up to 3 cleanup batches at once) can overshoot a budget a little,
# a call killed by the timeout has no cost figure. These are brakes, not the backstop: the Console spend limit is.
# 일일 한도: 오늘(로컬 날짜) 누적 비용이 한도에 닿으면 그날 이후 Claude 단계를 건너뜁니다(정리/검증은 경고와 함께 생략, 노트는 budget_daily로 실패하되 transcript는 게시되고
# 자정까지 대기, 실패 시도로 세지 않음). 회의별 한도: 한 번의 처리 실행이 한도에 닿으면 정리/검증/캘린더를 건너뜁니다(노트 호출은 항상 확보). 호출 시작 전에 검사하므로
# 이미 실행 중인 호출(정리 배치 최대 3개)만큼은 약간 넘을 수 있습니다. 진짜 안전장치는 Console 월 지출 한도입니다. 0 = 끔.
CLAUDE_DAILY_BUDGET_USD=5
CLAUDE_MEETING_BUDGET_USD=2

# ============================== Meeting note / 회의록 (Python, Claude Code) ==============================

# Model alias passed to 'claude --model' (opus = best accuracy). Fallback is tried once if the first model fails.
# 'claude --model'에 넘길 모델 별칭. 실패 시 폴백 모델로 한 번 재시도합니다.
NOTE_MODEL=opus
NOTE_FALLBACK_MODEL=sonnet

# Reasoning effort for 'claude --effort': low | medium | high | xhigh | max / 추론 강도
NOTE_EFFORT=high

# Language of the note body: auto = the meeting's main language (Korean or English, English terms kept), ko, en.
# Headings and table columns always stay in English. / 본문 언어: auto(회의의 주 언어) | ko | en. 제목/표 헤더는 항상 영어.
NOTE_LANGUAGE=auto

# Hard limit for one Claude call (seconds) / Claude 호출 1회 제한 시간(초)
NOTE_TIMEOUT_SECONDS=1200
# (api mode: a call that is killed by this limit has no cost figure in usage.jsonl, so it counts as 0 in the budgets.)

# Extra usage (overage), CLAUDE_AUTH=subscription only (ignored in api mode: the Console key has no subscription window, nothing is written to
# overage.json). When Claude reports that extra-usage billing is on (the subscription window is used up), an observation is logged, written to
# SUPPORT_DIR/overage.json and shown as a warning in state.json / the note footer. Whichever billing mode is on, the child environment is an
# allow-list, --bare is never used and every call is checked on its own stream (apiKeySource must be "none" for the subscription,
# "ANTHROPIC_API_KEY" for api).
# 1 = (default) stop writing notes while Claude reports extra-usage billing, until the reported reset time, and keep only the transcript
# ('mcap reprocess --allow-overage' forces one).   0 = allow extra usage on purpose, only record it. Use exactly 1 or 0.
# Extra usage(초과 사용)는 구독 한도를 다 쓴 뒤의 추가 과금입니다. 관측하면 로그, overage.json, state.json 경고, 노트 푸터에 기록합니다. API 키 경로는 이 설정과 무관합니다.
# 1 = (기본) 초과 과금 보고 시 리셋 시각까지 노트 생성 중단(transcript만 보존, --allow-overage로 강제) | 0 = 의도적으로 허용하고 기록만. 값은 1 또는 0만 사용.
NOTE_STOP_ON_OVERAGE=1

# Transcript cleanup (LLM pass, Claude Code): fixes terminology / transliteration / homophone ASR errors using vocabulary.txt and the context
# (e.g. "에프디에이" -> FDA) and writes transcript.cleaned.md/.json NEXT TO the raw transcript (the raw transcript.md/json are never changed).
# Numbers/dates/prices are verified by code and never touched. The note is written from the cleaned transcript when it is valid, else from
# the raw one. Fail-soft: any problem = the raw transcript is used. At most about 25 Claude calls per meeting. 1 = on, 0 = off.
# 전사 교정(LLM 패스): vocabulary와 문맥으로 용어/음차/동음 오류만 교정해 transcript.cleaned.md/.json을 원본 옆에 따로 저장(원본은 절대 수정 안 함).
# 숫자/날짜/가격은 코드가 검증하며 바꾸지 않음. 노트는 교정본이 유효하면 교정본으로, 아니면 원본으로 작성. 실패하면 원본으로 계속. 1 = 켜기 | 0 = 끄기
TRANSCRIPT_CLEANUP=1

# Hard cap on Claude calls (claude -p) for ONE run of a meeting: transcript-cleanup batches + note + verification + calendar lookup,
# retries included. The note always comes first (its 2 calls, primary + fallback model, are reserved before anything else), the calendar
# lookup (1) and the verification (2) keep theirs, the transcript cleanup gets what is left (25 at the default 30) and makes bigger batches
# when the cap is small. A stage that finds no call left is skipped with a warning (state.json) and the note says so: "Verification: not
# applied (...)" under its title and in its footer, "transcript: raw (cleanup not applied: ...)" in the footer. Every call is logged in
# ~/Library/Application Support/MeetingCapture/usage.jsonl; 'mcap usage' and 'mcap doctor' print the last 7 days.
# 한 회의 처리 1회당 Claude 호출(claude -p) 상한(정리 배치 + 노트 + 검증 + 캘린더, 재시도 포함). 노트가 항상 우선(호출 2회 선확보), 캘린더(1)/검증(2)도
# 각자 확보하고 남은 만큼만 전사 교정이 사용(기본 30이면 25). 상한 때문에 건너뛴 단계는 경고로 남고 노트 맨 위/푸터에 명시됩니다. 호출 기록: usage.jsonl.
MAX_CLAUDE_CALLS_PER_MEETING=30

# Note verification (second Claude call): fact-checks the draft note against the transcript (every decision, action item owner/due, number, date and
# attribution) and removes or marks unsupported items "(근거 불명확 / not supported by transcript)". The draft is kept as meeting-note.draft.md; the
# final note ends with a short Verification comment. Code checks that the headings survive and that no number appears that is not in the
# transcript; on any problem the draft is kept and a warning is recorded. 1 = on, 0 = off.
# 노트 검증(두 번째 Claude 호출): 초안 노트를 transcript와 대조(결정/담당자/기한/숫자/날짜/발언자)해 근거 없는 항목을 제거하거나 "(근거 불명확 / not supported by transcript)"로 표기.
# 초안은 meeting-note.draft.md로 보존, 최종 노트 끝에 Verification 주석. 헤딩 유지/숫자 근거는 코드가 검증, 문제가 있으면 초안 유지 + 경고. 1 = 켜기 | 0 = 끄기
NOTE_VERIFY=1

# Meeting title / attendees from Google Calendar through the claude.ai connector (best effort, 90 s limit, read-only): auto = try, 0 = off.
# BILLING: this one call ALWAYS runs on the claude.ai subscription login, also when CLAUDE_AUTH=api (the connector is tied to the login; an API
# key cannot use it). No claude.ai login = it is skipped quietly. 이 호출만은 CLAUDE_AUTH=api여도 항상 구독 로그인으로 실행됩니다(로그인이 없으면 조용히 생략).
# PRIVACY: this is one extra Claude call per meeting. It asks only for the events within +-45 minutes of the recording START (the events of
# that window, with their titles and attendees, pass through that Claude session); only the one event that matches the meeting is kept
# (calendar.json in the meeting folder: title, start/end, attendee names and emails). Set CALENDAR_LOOKUP=0 and no calendar data is
# requested at all; the window title or the platform name is used for the title then, and on any failure as well.
# This example file ships 0 (off). Set auto to turn the lookup on; without the key the built-in value is auto.
# 캘린더에서 회의 제목/참석자 조회(claude.ai 커넥터, 읽기 전용, 실패하면 조용히 창 제목/플랫폼명으로 대체): auto | 0. 이 예시 파일은 0(끔)으로 시작합니다.
# 개인정보: 녹음 시작 +-45분 안의 일정만 요청하고(그 일정의 제목/참석자가 Claude 세션을 지나감) 회의와 일치하는 일정 1건만 보관합니다
# (회의 폴더의 calendar.json: 제목, 시작/종료, 참석자 이름/이메일). CALENDAR_LOOKUP=0 이면 캘린더 데이터를 전혀 요청하지 않습니다.
CALENDAR_LOOKUP=0

# The app runs 'mcap reprocess --pending' this often (hours, 0 = off) while failed-but-retryable sessions exist (Drive was unmounted, Claude
# usage limit reached and reset since, a transcription that died, ...). It never touches a recording in progress. Run it by hand any time.
# 앱이 실패했지만 재시도 가능한 세션이 있으면 이 주기(시간, 0 = 끔)로 'mcap reprocess --pending'을 실행합니다. 녹음 중인 세션은 건드리지 않습니다.
RETRY_SWEEP_HOURS=6

# ============================== Storage / 보관 ==============================

# 0 = keep audio forever. N > 0: 'mcap prune-audio' (and every processing run) deletes *.m4a of meetings older than N days.
# Transcripts and notes are never deleted. / 0 = 오디오 영구 보관. N>0이면 N일 지난 *.m4a만 삭제(transcript/노트는 절대 삭제 안 함).
AUDIO_RETENTION_DAYS=0

# ============================== Calendar autostart / 캘린더 자동 시작 (Swift app + 'mcap gcal') ==============================

# OFF by default (the lines are commented out and show the built-in default). WARNING: with auto the app starts a recording for an in-person
# conversation that is in your Google Calendar, without you pressing anything, so it records whoever is in the room. Recording people can need
# their consent and can be illegal where you are: read docs/CALENDAR_AUTOSTART.md first. It is a single-user feature (your own Google Cloud
# project and OAuth client, read-only calendar access, one sign-in with 'python -m mcap gcal auth'); nothing is sent anywhere but Google.
# 기본은 꺼짐(주석 처리된 줄은 내장 기본값입니다). 경고: auto이면 앱이 Google 캘린더에 있는 대면 대화에 대해 버튼 없이 스스로 녹음을 시작하므로
# 그 자리에 있는 모든 사람이 녹음됩니다. 사람을 녹음하는 일은 동의가 필요하거나 지역에 따라 불법일 수 있습니다. 먼저 docs/CALENDAR_AUTOSTART.md를
# 읽으세요. 한 사람(소유자) 전용 기능입니다(본인의 Google Cloud 프로젝트와 OAuth 클라이언트, 읽기 전용 캘린더 권한, 'python -m mcap gcal auth'로 한 번 로그인).
# off | auto. Any other text is read as off.
# OFFLINE_AUTOSTART=off
# A recording may start this many minutes before the event starts (0 to 30), and up to this many minutes after it started (0 to 120).
# 일정 시작 몇 분 전부터(0~30), 시작 후 몇 분까지(0~120) 녹음을 시작할 수 있습니다.
# OFFLINE_START_BEFORE_MINUTES=2
# OFFLINE_START_AFTER_MINUTES=15
# A recording that this feature started stops this many minutes after the event's end (0 to 120).
# 이 기능이 시작한 녹음은 일정 종료 후 이 시간(분)이 지나면 멈춥니다(0~120).
# OFFLINE_STOP_AFTER_END_MINUTES=10
# No keyboard or mouse input for longer than this many minutes (1 to 120) means nobody is at the Mac: no automatic start.
# 키보드/마우스 입력이 이 시간(분)보다 오래 없으면 자리에 아무도 없다고 보고 자동 시작하지 않습니다(1~120).
# OFFLINE_IDLE_MAX_MINUTES=5
# 1 = the event needs at least one attendee besides you (a block with nobody else is not a conversation). 0 = no such need.
# 1 = 본인 외 참석자가 1명 이상인 일정만 녹음(혼자 잡은 일정은 대화가 아님). 0 = 조건 없음.
# OFFLINE_REQUIRE_GUESTS=1
# Events shorter than OFFLINE_MIN_MINUTES (1 to 600) or longer than OFFLINE_MAX_MINUTES (1 to 1440) are never recorded.
# 이보다 짧거나(1~600) 긴(1~1440) 일정은 녹음하지 않습니다.
# OFFLINE_MIN_MINUTES=10
# OFFLINE_MAX_MINUTES=240

# ============================== Cloud ASR providers: CLOVA, OpenAI-compatible / 클라우드 ASR 제공자: CLOVA, OpenAI 호환 ==============================

# OFF by default (the lines are commented out and show the built-in default). A cloud engine runs only when ALL of these hold: ASR_ENGINE (or
# ASR_FALLBACK, in the next section) names it, the meeting is not local-only, your organisation policy (if you have one) allows it, and you typed a consent
# ('mcap asr-engines consent clova'). The API key lives in the Keychain only ('mcap asr-engines secret set clova'), never in this file. Billing is
# between you and the vendor: this program only records the audio seconds of every request (asr-usage.jsonl) and keeps the daily cap
# ASR_CLOUD_DAILY_MINUTES (raise it for heavy use). A cloud engine gets BLOCKS of speech (the pauses are cut out), not 28-second chunks, because the vendor
# rounds every request up. Setup: docs/CONFIGURATION.md "Cloud providers". A new vendor is one adapter class and one registry entry: docs/ADD_A_PROVIDER.md.
# 기본으로 꺼져 있습니다(줄은 주석 처리돼 있고 내장 기본값을 보여 줍니다). 클라우드 엔진은 다음이 모두 맞을 때만 쓰입니다: 다음 절의 ASR_ENGINE(또는 ASR_FALLBACK)에 이름이 있고,
# 그 회의가 로컬 전용이 아니고, 조직 정책이 허용하고, 사용자가 동의('mcap asr-engines consent clova')를 입력한 경우. API 키는 Keychain에만 두고
# ('mcap asr-engines secret set clova') 이 파일에는 쓰지 않습니다. 요금은 사용자와 벤더 사이의 일입니다: 이 프로그램은 요청마다 오디오 초만 기록하고(asr-usage.jsonl)
# 하루 상한 ASR_CLOUD_DAILY_MINUTES만 지킵니다(많이 쓰면 올리세요). 벤더가 요청마다 올림해 과금하므로 클라우드 엔진에는 28초 청크가 아니라 쉼을 잘라 낸 발화 블록을 보냅니다.

# NAVER CLOVA Speech (long-sentence upload API, ASR_ENGINE=clova): the invoke URL of your own domain, https, a NAVER Cloud gateway host (.ncloud.com,
# .fin-ncloud.com, .gov-ncloud.com). Host and port are bound into the consent and the Keychain key; the path (the id of your domain) is never logged or stored.
# Empty = not configured. / 본인 도메인의 인보크 URL: https, NAVER Cloud 게이트웨이 호스트(.ncloud.com, .fin-ncloud.com, .gov-ncloud.com). 호스트와 포트는 동의와 Keychain 키에
# 결박되고 경로(도메인 식별자)는 로그나 상태에 남기지 않습니다. 비우면 설정 안 됨.
# ASR_CLOVA_INVOKE_URL=
# ko-KR | en-US | enko (Korean and English in one request) | ja | zh-cn | zh-tw. ASR_LANGUAGE is not used by this engine. Unknown text reads as enko.
# ko-KR | en-US | enko(한 요청에 한국어와 영어) | ja | zh-cn | zh-tw. 이 엔진은 ASR_LANGUAGE를 쓰지 않습니다. 알 수 없는 값은 enko.
# ASR_CLOVA_LANGUAGE=enko
# Speaker separation: on | off | auto. auto = on for the only track of a meeting (an offline meeting) and for the remote track of an online meeting, off for the
# microphone track of an online meeting. / 화자 분리: on | off | auto. auto = 회의의 유일한 트랙(오프라인 회의)과 온라인 회의의 상대 트랙은 켜고, 온라인 회의의 마이크 트랙은 끕니다.
# ASR_CLOVA_DIARIZATION=auto

# Any server with an OpenAI-style POST <base>/audio/transcriptions (ASR_ENGINE=openai-compat): OpenAI itself, a faster-whisper server, your own gateway.
# YOU choose the destination and the vendor behind it, so the consent names the host and a company policy needs asr.allow_foreign. https and a DNS name only (never an
# IP address). The key is optional: sent only when one is stored. The model is the "model" field of the request (one word). No vocabulary is sent.
# OpenAI 방식 POST <base>/audio/transcriptions를 받는 서버(OpenAI 자체, faster-whisper 서버, 자체 게이트웨이). 보내는 곳과 그 뒤의 벤더는 사용자가 정하므로 동의 문구가 호스트를
# 밝히고 회사 정책은 asr.allow_foreign이 필요합니다. https와 DNS 이름만(IP 주소 불가). 키는 선택이고 저장돼 있을 때만 보냅니다. 용어집은 보내지 않습니다.
# ASR_OPENAI_COMPAT_URL=
# ASR_OPENAI_COMPAT_MODEL=whisper-1

# Seconds of speech in one upload (30 to 1800) of an engine that takes blocks (clova, openai-compat; openai-compat never uses more than 720: OpenAI takes 25 MB per
# file). A longer block means fewer requests to round up; a failed block costs that many seconds of text at once. A block goes to ASR_FALLBACK whole only when the
# fallback takes audio that long: a Whisper or Azure fallback gets the chunks of the block one by one. A service that answers 413 (too large) gets shorter blocks.
# The request time limit is the larger of ASR_REQUEST_TIMEOUT_S and 60 s plus the audio seconds of the block (at most 600 s).
# 블록을 받는 엔진(clova, openai-compat)의 한 번 업로드에 담는 발화 길이(초, 30~1800, openai-compat는 OpenAI의 파일당 25 MB 때문에 720초를 넘기지 않습니다). 길수록 올림 과금이
# 줄지만 블록이 실패하면 그만큼의 텍스트를 한꺼번에 잃습니다. 블록은 폴백이 그 길이를 받을 때만 통째로 ASR_FALLBACK에 넘기고, Whisper나 Azure 폴백에는 블록의 청크를 하나씩 보냅니다.
# 서비스가 413(너무 큼)으로 답하면 더 짧은 블록으로 다시 보냅니다. 요청 제한 시간은 ASR_REQUEST_TIMEOUT_S와 (60초 + 블록의 오디오 초) 중 큰 값입니다(최대 600초).
# ASR_CLOUD_BLOCK_SECONDS=900

# ============================== Privacy lanes, external ASR, local data / 개인정보 레인, 외부 ASR, 로컬 데이터 (Python + Swift) ==============================

# Everything below is OFF or unchanged by default. The lines are commented out and show the built-in default of each key: remove the '#' to
# change one (the pipeline reads config.env on every run, the app after a restart). With none of them set this Mac behaves exactly as before:
# local Whisper, no audio sent anywhere, nothing blocked. Keys that your installed pipeline or app version does not know are ignored by it
# (they need pipeline 0.2.0 / the app that ships SPEC 18). Secrets (Azure key, relay token) never go into this file: they live in the Keychain.
# Rules: docs/PRIVACY_LANES.md (what can leave this Mac and when), docs/POLICY.md (organisation policy), docs/ASR_PROTOCOL.md (server protocol).
# A Mac managed by an organisation policy (/Library/Application Support/MeetingCapture/policy.json) can only be restricted further by these keys,
# never relaxed, and it ignores SUPPORT_DIR, PYTHON_BIN, PROJECT_DIR and CLAUDE_BIN of this file.
# 아래 키는 전부 기본으로 꺼져 있거나 현행 동작 그대로입니다. 줄은 주석 처리돼 있고 각 키의 내장 기본값을 보여 줍니다. 바꾸려면 '#'을 지우세요
# (파이프라인은 매 실행, 앱은 재시작 후 반영). 하나도 설정하지 않으면 지금과 똑같이 동작합니다(로컬 Whisper, 오디오 송신 없음, 차단 없음).
# 설치된 파이프라인/앱 버전이 모르는 키는 무시됩니다(파이프라인 0.2.0 / SPEC 18을 담은 앱 필요). 비밀(Azure 키, 릴레이 토큰)은 이 파일에 쓰지 않고 Keychain에만 둡니다.
# 조직 정책(policy.json)이 있는 Mac에서는 이 키로 제한만 더할 수 있고 완화할 수 없으며, 이 파일의 SUPPORT_DIR, PYTHON_BIN, PROJECT_DIR, CLAUDE_BIN은 무시됩니다.

# --- Per-meeting local-only switch / 회의별 로컬 전용 ---
# Default of the "Local-Only Meeting" switch for NEW recordings. 1 = a new recording starts local-only: its transcript is made on this Mac and the
# five lanes that can leave it are all skipped: external ASR (remote and cloud), Claude (cleanup, note, verification), the calendar lookup and the
# Drive upload; the meeting is kept under LOCAL_ARCHIVE_DIR. Any unrecognised text is read as 1 (fail closed). An organisation policy can raise
# the default (or lock it), the user cannot lower it below the policy.
# 새 녹음의 '로컬 전용 회의' 기본값. 1이면 새 녹음은 로컬 전용으로 시작합니다: 전사는 이 Mac에서만 하고 나갈 수 있는 다섯 레인(원격/클라우드 ASR, Claude 정리/노트/검증,
# 캘린더 조회, Drive 업로드)을 모두 건너뜁니다(LOCAL_ARCHIVE_DIR에 보관). 알 수 없는 값은 1로 읽습니다. 조직 정책이 기본값을 올리거나 잠글 수 있습니다.
# LOCAL_ONLY_DEFAULT=0

# --- ASR engine / 전사 엔진 ---
# Primary engine: whisper = local mlx-whisper (today's behaviour) | remote = the company mcap-asr server | azure = Azure Speech (Korea Central) | clova = NAVER CLOVA
# Speech | openai-compat = a server of your choice with the OpenAI transcription API (the last two: the section above) | auto.
# auto = local Whisper when the hardware probe says this Mac is capable, else remote. An external engine runs only when ALL of these hold: the meeting is
# not local-only, the organisation policy allows it, you gave a consent (mcap asr-engines consent <engine>), and it is named here or in ASR_FALLBACK.
# An unknown value falls back to whisper with a warning. There is no automatic switch to a cloud engine.
# 주 엔진: whisper(로컬, 현행) | remote(회사 mcap-asr 서버) | azure(Azure Speech 한국 중부) | clova(NAVER CLOVA Speech) | openai-compat(사용자가 고른 OpenAI 전사 API 서버, 위 절) | auto(로컬이 가능한 Mac이면 whisper, 아니면 remote). 외부 엔진은 회의가 로컬 전용이 아니고,
# 조직 정책이 허용하고, 사용자 동의가 있고, 여기나 ASR_FALLBACK에 명시된 경우에만 쓰입니다. 알 수 없는 값은 whisper(경고). 클라우드로 자동 전환되는 일은 없습니다.
# ASR_ENGINE=whisper
# Engine for one chunk when the primary fails (never chained): none | whisper | remote | azure | clova | openai-compat. A non-local fallback also needs a consent with use fallback or both.
# 주 엔진이 실패했을 때 그 청크만 맡는 엔진(연쇄 없음): none | whisper | remote | azure | clova | openai-compat. 로컬이 아니면 용도가 fallback 또는 both인 동의가 필요합니다.
# ASR_FALLBACK=none
# Hardware verdict used by ASR_ENGINE=auto and by 'mcap doctor': minimum RAM (GB) and maximum measured real-time factor (mcap asr-engines check --probe).
# 엔진이 auto일 때와 doctor가 쓰는 로컬 전사 가능 판정 기준: 최소 RAM(GB), 측정 실시간 배율(RTF) 상한.
# ASR_LOCAL_MIN_RAM_GB=16
# ASR_LOCAL_MAX_RTF=0.25
# 1 = the Whisper model may be downloaded when it is missing (today's behaviour). Forced to 0 in local-only runs. Any unrecognised text is read as 0.
# 1 = 모델이 없으면 다운로드할 수 있음(현행). 로컬 전용 실행에서는 항상 0. 알 수 없는 값은 0.
# ASR_ALLOW_DOWNLOAD=1

# --- Company server (remote) / 회사 서버 ---
# Base URL of the mcap-asr/1 server: https only, a DNS name (never an IP address). Host and port must match a consent (or an organisation consent) AND the policy
# allowed_hosts; the Keychain token is bound to this host:port. Empty = no server.
# mcap-asr/1 서버 주소: https, DNS 이름만(IP 불가). 호스트와 포트는 동의와 정책 allowed_hosts에 맞아야 하고 Keychain 토큰은 이 host:port에 결박됩니다. 비우면 서버 없음.
# ASR_REMOTE_URL=
# PEM of the private CA that signs the server certificate: only this CA is trusted for that host. The file is read once and its sha256 must equal the
# ca_sha256 of the consent. Empty = none.
# 서버 인증서를 서명하는 사설 CA의 PEM. 그 호스트에는 이 CA만 신뢰하며 파일의 sha256이 동의의 ca_sha256과 같아야 합니다. 비우면 없음.
# ASR_REMOTE_CA_FILE=
# Longest total wait for one chunk (seconds) across retries, Retry-After waits and queueing before it counts as a transient failure.
# 청크 하나가 재시도, Retry-After 대기, 큐 대기를 모두 합해 기다리는 최대 시간(초). 넘으면 일시적 실패로 칩니다.
# ASR_REMOTE_MAX_WAIT_S=120

# --- Azure Speech (cloud) / Azure Speech ---
# Resource region (host = <region>.api.cognitive.microsoft.com); ASR_AZURE_HOST overrides it with a custom endpoint host and must end in
# .api.cognitive.microsoft.com or .cognitiveservices.azure.com. Changing either one invalidates the consent. The key is stored with
# 'mcap asr-engines secret set azure' (Keychain, bound to host:port), never here. Empty ASR_AZURE_HOST = derive it from the region.
# 리소스 리전(호스트 = <리전>.api.cognitive.microsoft.com). ASR_AZURE_HOST는 사용자 지정 엔드포인트로 덮어쓰며 위 두 접미사 중 하나로 끝나야 합니다. 바꾸면 동의가 무효가 됩니다.
# 키는 'mcap asr-engines secret set azure'로 Keychain에만 저장(host:port 결박)하고 여기에는 쓰지 않습니다. ASR_AZURE_HOST가 비어 있으면 리전에서 만듭니다.
# ASR_AZURE_REGION=koreacentral
# ASR_AZURE_HOST=
# Comma list of BCP-47 candidates (ko-KR,en-US). Empty = omit the locales (multilingual model). / 후보 로케일 목록. 비우면 생략(다국어 모델).
# ASR_AZURE_LOCALES=
# phraseList biasing weight 0.0 to 2.0 for the vocabulary.txt terms (only when ASR_SEND_VOCAB is on). / vocabulary.txt 용어의 phraseList 가중치(0.0~2.0, ASR_SEND_VOCAB가 켜진 때만).
# ASR_AZURE_BIAS=1.0
# Price in US dollars per audio hour, used only for the est_usd estimate in asr-usage.jsonl (0 = unknown, logged as null). The real bill is Azure Cost Management.
# asr-usage.jsonl의 est_usd 추정에만 쓰는 시간당 단가(USD). 0 = 모름(null로 기록). 실제 청구는 Azure Cost Management가 기준입니다.
# ASR_AZURE_USD_PER_HOUR=0

# --- External ASR limits / 외부 ASR 한도 ---
# Daily cap (local date) of audio sent to external engines from this Mac, in minutes: audio seconds plus 1 s per request, over every server and cloud engine.
# The effective cap is the smaller of this and the policy cap; 0 = no external audio. Client side and advisory (you can delete asr-usage.jsonl);
# the server's per-token quota is the authoritative counter.
# 이 Mac에서 외부 엔진으로 보내는 오디오의 하루(로컬 날짜) 상한(분): 오디오 초 + 요청당 1초. 정책 상한과 비교해 작은 값을 씁니다. 0 = 외부 오디오 없음. 클라이언트 쪽 자문(advisory)이고 권위 있는 값은 서버 쪽 토큰별 쿼터입니다.
# ASR_CLOUD_DAILY_MINUTES=240
# Timeout of one ASR HTTP request (seconds; keep it above the server queue cap of 45 s plus service time), attempts per chunk inside an external engine,
# and the circuit breaker: consecutive transient failures that open it for the rest of the run, and the cooldown (seconds) before one probe chunk goes to the primary again.
# ASR HTTP 요청 1회 제한 시간(초, 서버 큐 상한 45초 + 처리 시간보다 크게), 외부 엔진 안에서 청크당 시도 횟수, 서킷 브레이커(연속 일시 실패 횟수, 다시 탐침하기 전 대기 초).
# ASR_REQUEST_TIMEOUT_S=90
# ASR_RETRY_MAX=3
# ASR_CIRCUIT_FAILS=3
# ASR_CIRCUIT_COOLDOWN_S=120
# 1 = the vocabulary.txt terms are sent to an external engine (relay vocabulary PUT, Azure phraseList) and the consent text says so (the list can hold names of companies and
# people you would rather not send). Local Whisper always uses the full list. A policy can force it off per engine kind. Any unrecognised text is read as 0.
# 1 = vocabulary.txt 용어를 외부 엔진에 보냅니다(릴레이 vocab PUT, Azure phraseList). 동의 문구에 명시되며 목록에 외부에 보내고 싶지 않은 회사/사람 이름이 있을 수 있습니다. 로컬 Whisper는 항상 전체 목록을 씁니다. 알 수 없는 값은 0.
# ASR_SEND_VOCAB=1

# --- Local archive and local data / 로컬 아카이브와 로컬 데이터 ---
# Where local-only (and Drive-denied) meetings are kept: LOCAL_ARCHIVE_DIR/YYYY-MM/YYYY-MM-DD_HHMM_<slug>/. Empty = ~/Library/Application Support/MeetingCapture/local-meetings.
# It must sit under that folder (or a folder the policy allows), contain no symbolic link and be on the same disk as your home folder, otherwise processing stops with
# local_archive_unsafe. Never a Drive or other synced folder. An organisation policy cannot set this key.
# 로컬 전용(또는 Drive가 거부된) 회의의 보관 위치. 비우면 ~/Library/Application Support/MeetingCapture/local-meetings. 그 폴더 아래(또는 정책이 허용한 폴더 아래)여야 하고 심볼릭 링크가 없고
# 홈과 같은 디스크여야 하며 아니면 local_archive_unsafe로 멈춥니다. Drive 같은 동기화 폴더는 안 됩니다. 조직 정책은 이 키를 바꿀 수 없습니다.
# LOCAL_ARCHIVE_DIR=
# 0 = keep (today). N > 0: housekeeping deletes the *.m4a of local-archive meetings older than N days (transcripts are never deleted), and removes failed,
# non-retryable sessions from staging older than N days (a retryable failure is never removed by this).
# 0 = 보관(현행). N>0이면 로컬 아카이브의 N일 지난 *.m4a를 지우고(전사본은 절대 지우지 않음), staging의 재시도 불가 실패 세션 중 N일 지난 것을 지웁니다(재시도 가능 실패는 지우지 않음).
# LOCAL_ARCHIVE_RETENTION_DAYS=0
# STAGING_FAILED_RETENTION_DAYS=0

# --- Microphone mute, logs, status / 마이크 음소거, 로그, 상태 ---
# off | on. on = mute-aware microphone capture: zeros are recorded while a positive mute signal holds (an unknown signal records). Read by the app.
# Any unrecognised text is read as on. / off | on. on이면 음소거 신호가 확실한 동안 마이크 구간을 0으로 기록(신호를 모르면 녹음). 앱이 읽습니다. 알 수 없는 값은 on.
# MIC_MUTE_GATE=off
# 1 = pipeline logs may carry up to 60 characters of transcript text and the app log carries meeting titles (today). 0 = only a length and a short hash are
# logged, and titles and slug paths are left out of notifications and app log. Any unrecognised text is read as 0.
# 1 = 파이프라인 로그에 전사 조각(최대 60자), 앱 로그에 회의 제목이 들어갑니다(현행). 0 = 길이와 짧은 해시만 남기고 알림과 앱 로그에서 제목과 slug 경로를 뺍니다. 알 수 없는 값은 0.
# LOG_CONTENT=1
# pipeline-*.log older than this many days are deleted by housekeeping (0 = keep: today nothing is pruned), and the app.log rotation size in MB with 5 files
# kept (0 = no rotation, today; read by the app only). / 이 일수보다 오래된 pipeline-*.log 삭제(0 = 보관, 현행), app.log 회전 크기(MB, 5개 보관, 0 = 회전 없음, 앱만 읽음).
# LOG_RETENTION_DAYS=0
# APP_LOG_MAX_MB=0
# 1 = 'mcap status --write' (the MDM extension attribute) also reports coarse asr_usage_7d and llm_cost_7d_usd. 0 = device health only. An interactive 'mcap status' always shows everything.
# 1 = 'mcap status --write'(MDM 확장 속성)가 거친 단위의 asr_usage_7d, llm_cost_7d_usd도 보고. 0 = 기기 상태만. 터미널에서 직접 실행한 'mcap status'는 항상 전부 보여 줍니다.
# STATUS_INCLUDE_USAGE=0

# Tests only (not needed normally): another SUPPORT_DIR / 테스트 전용: SUPPORT_DIR 변경
# SUPPORT_DIR=~/Library/Application Support/MeetingCapture
