{
 "schema": 1,
 "about": [
  "Shared corpus of policy.json verdicts (docs/POLICY.md 14). The Python test (pipeline/tests/test_policy.py) and the Swift selftest",
  "(app/Sources/Policy.swift, selftest-policy) both read this file and must reach the same verdict for every case.",
  "A case names the policy text to read and the conditions it is read under (exactly one of file, content, content_hex):",
  "  file            fixture file name, or null = there is no policy.json (only the marker, if marker is true).",
  "  content         the EXACT text of policy.json (a JSON string, UTF-8, never re-serialised: 0 is not false, 1.0 is not 1, NaN stays NaN).",
  "  content_hex     the exact bytes of policy.json as hex, for input that is not text (a byte that is not UTF-8).",
  "  marker          true = the file policy.required exists next to policy.json. Default false.",
  "  pipeline_version the pipeline version compared with min_pipeline_version (tuple of integers). Default defaults.pipeline_version.",
  "  file_info       what lstat of policy.json reports; keys override defaults.file_info: type (file|symlink|directory|error), uid, mode",
  "                  (octal string, permission bits only), size (default: the byte length of the content actually read). type error = lstat of",
  "                  policy.json itself fails with a permission error.",
  "  ancestor_info   what lstat reports for EVERY ancestor directory of policy.json and for none else: uid, mode, type (directory by",
  "                  default; file = an ancestor that is not a directory).",
  "  prefix_hex / strip_prefix_hex / append_hex / truncate_to   byte-level edits of the file or content before it is read, in this order:",
  "                  strip the leading bytes (they must be there), prepend prefix_hex, append append_hex, then cut to truncate_to bytes.",
  "expect: state absent | valid | invalid; for invalid, reason is a substring of the lock reason (the lock reason is the code, or",
  "  'code: where' with a key path; the shared proof is the CODE: the codes are listed in reason_codes below);",
  "  lanes = the EFFECTIVE verdict of the five lanes (approvals and the signature pin applied; absent = all allow, invalid = all deny);",
  "  lane_reasons (optional) = the policy-level reason of each deny; local_only_default / local_only_locked = the values the app uses",
  "  (an invalid policy forces both true); recording_enabled (an invalid policy keeps recording on); profile, revision, allowed_engines,",
  "  allowed_hosts, archive_allowed_roots, local_roots (null = no restriction, [] = nothing allowed) are checked when present.",
  "  An invalid case may leave out lanes, local_only_default, local_only_locked and recording_enabled: defaults.invalid_expect holds them.",
  "  enforced (optional) = the exact enforced layer the config reads (the company baseline of defaults.company_baseline_enforced, plus the",
  "  policy's own enforced keys when it is valid). When it is left out: absent = {}, valid = not checked, invalid = the company baseline",
  "  UNLESS the locked file still positively says profile personal (then {}): a damaged policy must not loosen the privacy settings.",
  "Reading rules the cases pin: strict closed schema (unknown key = lock, only ext is free), BOM or duplicate key = lock, a lane value that",
  "is not exactly the string allow is deny for THAT lane only, company: omitted lists are empty and allow needs an approval reference,",
  "a number where a bool is required (0/1) or a bool where a number is required locks (never read through a number-to-bool bridge),",
  "schema and revision are integers (true, 1.0, \"1\" lock), NaN / Infinity / 1e999 lock, a version is ASCII digits and dots only,",
  "an archive root must be anchored ('/...', '~' or '~/...': never relative, '*', '.', '~user'),",
  "a locked verdict is confirmed by a second read 500 ms later (not visible here: the fixtures are static)."
 ],
 "reason_codes": [
  "bom",
  "not-utf8",
  "bad-json",
  "duplicate-key",
  "not-object",
  "bad-schema",
  "no-profile",
  "bad-profile",
  "bad-revision",
  "unknown-key",
  "forbidden-key",
  "bad-type",
  "bad-value",
  "not-regular-file",
  "bad-owner",
  "group-or-other-writable",
  "too-large",
  "parent-bad-owner",
  "parent-writable",
  "parent-unreadable",
  "unreadable",
  "required-missing",
  "pipeline-too-old",
  "internal-error"
 ],
 "reason_codes_without_a_case": [
  "internal-error"
 ],
 "defaults": {
  "pipeline_version": "0.2.0",
  "marker": false,
  "file_info": {
   "type": "file",
   "uid": 0,
   "mode": "0644"
  },
  "ancestor_info": {
   "uid": 0,
   "mode": "0755"
  },
  "company_baseline_enforced": {
   "LOG_CONTENT": "0",
   "ASR_ALLOW_DOWNLOAD": "0",
   "MIC_MUTE_GATE": "on",
   "NOTIFY_RECORDING": "1"
  },
  "invalid_expect": {
   "lanes": {
    "asr_remote": "deny",
    "asr_cloud": "deny",
    "llm": "deny",
    "calendar": "deny",
    "drive": "deny"
   },
   "local_only_default": true,
   "local_only_locked": true,
   "recording_enabled": true
  }
 },
