 "env_parse": [
  {
   "text": "A=1\n",
   "expect": {
    "A": "1"
   }
  },
  {
   "text": "  B = two  # comment\n",
   "expect": {
    "B": "two"
   }
  },
  {
   "text": "C=\"quoted value\"\nD='single'\n",
   "expect": {
    "C": "quoted value",
    "D": "single"
   }
  },
  {
   "text": "E=a#b\n",
   "expect": {
    "E": "a#b"
   }
  },
  {
   "text": "F=~/My Drive/Meetings\n",
   "expect": {
    "F": "~/My Drive/Meetings"
   }
  },
  {
   "text": "G=x=y\n",
   "expect": {
    "G": "x=y"
   }
  },
  {
   "text": "# comment\n\nH=1\n",
   "expect": {
    "H": "1"
   }
  },
  {
   "text": "I=\n",
   "expect": {
    "I": ""
   }
  },
  {
   "text": "J=1\nJ=2\n",
   "expect": {
    "J": "2"
   }
  },
  {
   "text": "K=1\r\nL=2\r\n",
   "expect": {
    "K": "1",
    "L": "2"
   }
  },
  {
   "text": "M= \"in quotes\" # note\n",
   "expect": {
    "M": "in quotes"
   }
  },
  {
   "text": "N=1",
   "expect": {
    "N": "1"
   }
  },
  {
   "text": "just text\nO=1\n",
   "expect": {
    "O": "1"
   }
  },
  {
   "text": "P=a b  c\n",
   "expect": {
    "P": "a b  c"
   }
  },
  {
   "text": "Q=it's fine\n",
   "expect": {
    "Q": "it's fine"
   }
  },
  {
   "text": "R= # only a comment\n",
   "expect": {
    "R": ""
   }
  }
 ],
 "writer": [
  {
   "name": "update keeps neighbours",
   "text": "# top\nUI_LANGUAGE=en\nOTHER=keep   # note\n",
   "changes": {
    "UI_LANGUAGE": "ko"
   },
   "result": "# top\nUI_LANGUAGE=ko\nOTHER=keep   # note\n"
  },
  {
   "name": "update keeps blanks and the trailing comment",
   "text": "SELF_NAME =  Me   # label\n",
   "changes": {
    "SELF_NAME": "Sam"
   },
   "result": "SELF_NAME =  Sam   # label\n"
  },
  {
   "name": "double quotes stay",
   "text": "ARCHIVE_DIR=\"~/My Meetings\"\n",
   "changes": {
    "ARCHIVE_DIR": "~/Other Meetings"
   },
   "result": "ARCHIVE_DIR=\"~/Other Meetings\"\n"
  },
  {
   "name": "a value with the quote of the line is written bare",
   "text": "SELF_NAME='Me'\n",
   "changes": {
    "SELF_NAME": "Sam's"
   },
   "result": "SELF_NAME=Sam's\n"
  },
  {
   "name": "insert at the end under one header",
   "text": "A=1\n",
   "changes": {
    "NOTE_MODEL": "sonnet"
   },
   "result": "A=1\n\n# Added by the Settings window\nNOTE_MODEL=sonnet\n"
  },
  {
   "name": "insert into an empty file",
   "text": "",
   "changes": {
    "UI_LANGUAGE": "ko"
   },
   "result": "# Added by the Settings window\nUI_LANGUAGE=ko\n"
  },
  {
   "name": "insert after a last line without a newline",
   "text": "A=1",
   "changes": {
    "B": "2"
   },
   "result": "A=1\n\n# Added by the Settings window\nB=2\n"
  },
  {
   "name": "the header is reused",
   "text": "A=1\n\n# Added by the Settings window\nB=2\n",
   "changes": {
    "C": "3"
   },
   "result": "A=1\n\n# Added by the Settings window\nB=2\nC=3\n"
  },
  {
   "name": "remove takes every line of the key",
   "text": "A=1\nB=2\nA=3\n",
   "changes": {
    "A": null
   },
   "result": "B=2\n"
  },
  {
   "name": "only the last duplicate is rewritten",
   "text": "A=1\nA=2\n",
   "changes": {
    "A": "9"
   },
   "result": "A=1\nA=9\n"
  },
  {
   "name": "CRLF, comments and unknown keys stay",
   "text": "# c\r\nX_UNKNOWN=zz\r\nUI_LANGUAGE=en\r\n",
   "changes": {
    "UI_LANGUAGE": "ko"
   },
   "result": "# c\r\nX_UNKNOWN=zz\r\nUI_LANGUAGE=ko\r\n"
  },
  {
   "name": "CRLF insert",
   "text": "A=1\r\n",
   "changes": {
    "B": "2"
   },
   "result": "A=1\r\n\r\n# Added by the Settings window\r\nB=2\r\n"
  },
  {
   "name": "a commented key is not a definition",
   "text": "# NOTE_MODEL=opus\n",
   "changes": {
    "NOTE_MODEL": "sonnet"
   },
   "result": "# NOTE_MODEL=opus\n\n# Added by the Settings window\nNOTE_MODEL=sonnet\n"
  },
  {
   "name": "an empty value before a comment gets a blank before the comment",
   "text": "EXTRA_MEETING_APPS=  # none\n",
   "changes": {
    "EXTRA_MEETING_APPS": "com.example.talk=Example Talk"
   },
   "result": "EXTRA_MEETING_APPS=  com.example.talk=Example Talk # none\n"
  },
  {
   "name": "an empty list is a value",
   "text": "ENABLED_PLATFORMS=zoom,teams\n",
   "changes": {
    "ENABLED_PLATFORMS": ""
   },
   "result": "ENABLED_PLATFORMS=\n"
  },
  {
   "name": "indentation and blank lines stay",
   "text": "\n  UI_LANGUAGE = en\n\n",
   "changes": {
    "UI_LANGUAGE": "ko"
   },
   "result": "\n  UI_LANGUAGE = ko\n\n"
  },
  {
   "name": "two changes at once",
   "text": "A=1\nB=2\n",
   "changes": {
    "A": null,
    "B": "3",
    "C": "4"
   },
   "result": "B=3\n\n# Added by the Settings window\nC=4\n"
  }
 ],
